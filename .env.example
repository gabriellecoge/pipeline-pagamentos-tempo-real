# O scripts/subir.sh copia este arquivo para .env na primeira vez.
# O .env NUNCA vai para o GitHub (está no .gitignore).
# Se quiser, troque as senhas no .env antes de subir.

# --- Postgres (banco de origem) ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=pagamentos
PG_USER=postgres
PG_PASSWORD=troque-esta-senha-pg

# --- Identidades do Kafka ---
ESCRITOR_SENHA=troque-esta-senha-escritor
LEITOR_SENHA=troque-esta-senha-leitor

# --- Endereços usados pelos scripts Python ---
KAFKA_BOOTSTRAP=localhost:9094
SR_URL=http://localhost:8081
