{
  "name": "pipeline-pagamentos-tempo-real",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "postCreateCommand": "pip install -r requirements.txt && cp -n .env.example .env",
  "forwardPorts": [8080, 8082],
  "portsAttributes": {
    "8080": { "label": "Kafka UI" },
    "8082": { "label": "Painel do Flink" },
    "8081": { "label": "Schema Registry", "onAutoForward": "silent" },
    "8083": { "label": "Kafka Connect", "onAutoForward": "silent" },
    "5432": { "label": "Postgres", "onAutoForward": "silent" },
    "9094": { "label": "Kafka", "onAutoForward": "silent" }
  }
}
